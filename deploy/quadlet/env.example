# Copy to /etc/kulhanek-points-tracker/env and fill in real values.
# This file is read by the Quadlet unit's EnvironmentFile= directive.

PORT=8080
DATA_DIR=/data
# Set to false only if the app is reachable directly (not behind a trusted
# reverse proxy). When true, the client IP for login rate limiting is read
# from X-Forwarded-For, so the proxy MUST overwrite that header and the app
# MUST NOT be exposed directly.
TRUST_PROXY=true
# Externally-reachable URL of this app (through your reverse proxy) —
# used to build the Gmail OAuth redirect URL. Must match what you register
# as an authorized redirect URI in Google Cloud Console
# (BASE_URL + /oauth/google/callback).
BASE_URL=https://points.example.com

# Seeds the single admin account on first boot only; changing these after
# the first boot has no effect (see internal/auth/admin_bootstrap.go).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional — omit both to hide the "Connect Gmail" option and use SMTP only.
# One-time OAuth client from https://console.cloud.google.com/apis/credentials
# (type "Web application", authorized redirect URI as described above).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
