package accountsview

import (
	"fmt"

	"github.com/wkulhanek/points-tracker/internal/accounts"
	"github.com/wkulhanek/points-tracker/internal/providers"
)

templ Form(a accounts.Account, isNew bool, errorMsg string, knownOwners []string) {
	if isNew {
		@newForm(a, errorMsg, knownOwners)
	} else {
		@editForm(a, errorMsg, knownOwners)
	}
}

templ newForm(a accounts.Account, errorMsg string, knownOwners []string) {
	<div class="mb-6 rounded-lg border border-slate-200 bg-white p-4">
		if errorMsg != "" {
			<div class="mb-3 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 ring-1 ring-red-200">{ errorMsg }</div>
		}
		<form
			hx-post="/accounts"
			hx-target="#account-rows"
			hx-swap="beforeend"
			class="grid grid-cols-2 gap-3 sm:grid-cols-3"
		>
			@fields(a, knownOwners)
			<div class="col-span-full flex justify-end gap-2 pt-1">
				<button
					type="button"
					onclick="document.getElementById('account-form-slot').innerHTML=''"
					class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
				>
					Cancel
				</button>
				<button type="submit" class="rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700">
					Add account
				</button>
			</div>
		</form>
	</div>
}

templ editForm(a accounts.Account, errorMsg string, knownOwners []string) {
	<tr id={ rowID(a.ID) }>
		<td colspan="10" class="bg-slate-50 px-4 py-4">
			if errorMsg != "" {
				<div class="mb-3 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 ring-1 ring-red-200">{ errorMsg }</div>
			}
			<form
				hx-post={ fmt.Sprintf("/accounts/%d", a.ID) }
				hx-target={ "#" + rowID(a.ID) }
				hx-swap="outerHTML"
				class="grid grid-cols-2 gap-3 sm:grid-cols-3"
			>
				@fields(a, knownOwners)
				<div class="col-span-full flex justify-end gap-2 pt-1">
					<button
						type="button"
						hx-get={ fmt.Sprintf("/accounts/%d", a.ID) }
						hx-target={ "#" + rowID(a.ID) }
						hx-swap="outerHTML"
						class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-white"
					>
						Cancel
					</button>
					<button type="submit" class="rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700">
						Save
					</button>
				</div>
			</form>
		</td>
	</tr>
}

templ fields(a accounts.Account, knownOwners []string) {
	<div class="col-span-2 sm:col-span-1">
		<label class="block text-xs font-medium text-slate-600">Name</label>
		<input type="text" name="name" value={ a.Name } placeholder="e.g. Chase Sapphire Points" required
			class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm"/>
	</div>
	<div>
		<label class="block text-xs font-medium text-slate-600">Provider</label>
		<input type="text" name="provider" list="provider-suggestions" value={ a.Provider } placeholder="e.g. Chase" required
			class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm"/>
		<datalist id="provider-suggestions">
			for _, p := range providers.Common {
				<option value={ p }></option>
			}
		</datalist>
	</div>
	<div>
		<label class="block text-xs font-medium text-slate-600">Owner</label>
		<div class="relative mt-1" data-combobox>
			<input type="text" name="owner" value={ string(ownerOrDefault(a)) } placeholder="e.g. Joint" required
				autocomplete="off" data-combobox-input
				class="block w-full rounded-md border border-slate-300 px-3 py-2 pr-8 text-sm"/>
			<button type="button" tabindex="-1" data-combobox-toggle aria-label="Show known owners"
				class="absolute inset-y-0 right-0 flex items-center px-2 text-slate-400 hover:text-slate-600">
				<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06z" clip-rule="evenodd"></path>
				</svg>
			</button>
			<ul data-combobox-list class="absolute z-10 mt-1 hidden max-h-48 w-full overflow-auto rounded-md border border-slate-200 bg-white py-1 text-sm shadow-lg">
				for _, o := range knownOwners {
					<li data-combobox-option class="cursor-pointer px-3 py-1.5 hover:bg-slate-100">{ o }</li>
				}
			</ul>
		</div>
	</div>
	<div>
		<label class="block text-xs font-medium text-slate-600">Program kind</label>
		<select name="kind" required
			class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
			for _, k := range accounts.Kinds {
				<option value={ string(k) } selected?={ kindOrDefault(a) == k }>{ string(k) }</option>
			}
		</select>
	</div>
	<div>
		<label class="block text-xs font-medium text-slate-600">Status</label>
		<input type="text" name="status" value={ a.Status } placeholder="e.g. Gold"
			class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm"/>
	</div>
	<div>
		<label class="block text-xs font-medium text-slate-600">Account number</label>
		<input type="text" name="account_number" value={ a.AccountNumber } placeholder="Optional"
			class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm"/>
	</div>
	<div>
		<label class="block text-xs font-medium text-slate-600">Points balance</label>
		<input type="number" name="points_balance" value={ formatPoints(a.PointsBalance) } min="0" required
			class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm"/>
	</div>
	<div>
		<label class="block text-xs font-medium text-slate-600">Last updated</label>
		<p class="mt-1 block w-full rounded-md border border-transparent px-3 py-2 text-sm text-slate-500">{ formatLastUpdated(a) }</p>
	</div>
	<div>
		<label class="block text-xs font-medium text-slate-600">Expiration date</label>
		<input type="date" name="expiration_date" value={ expirationInputValue(a) } required
			disabled?={ a.DoesNotExpire }
			class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm disabled:bg-slate-100 disabled:text-slate-400"/>
		<label class="mt-1 flex items-center gap-1.5 text-xs text-slate-600">
			<input type="checkbox" name="does_not_expire" checked?={ a.DoesNotExpire }
				onchange="this.closest('form').querySelector('[name=expiration_date]').disabled = this.checked"/>
			Does not expire
		</label>
	</div>
	<div class="col-span-full">
		<label class="block text-xs font-medium text-slate-600">Notes</label>
		<input type="text" name="notes" value={ a.Notes } placeholder="Optional"
			class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm"/>
	</div>
}
