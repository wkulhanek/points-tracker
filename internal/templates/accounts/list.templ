package accountsview

import (
	"github.com/wkulhanek/points-tracker/internal/accounts"
	"github.com/wkulhanek/points-tracker/internal/templates/components"
	"github.com/wkulhanek/points-tracker/internal/templates/layout"
)

templ List(appName string, accts []accounts.Account, flashKind string, flashMsg string) {
	@layout.Base("Accounts", appName, true) {
		@components.Flash(flashKind, flashMsg)
		<div class="mb-6 flex items-center justify-between">
			<h1 class="text-2xl font-semibold">Accounts</h1>
			<button
				hx-get="/accounts/new"
				hx-target="#account-form-slot"
				hx-swap="innerHTML"
				class="rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700"
			>
				Add account
			</button>
		</div>
		<div id="account-form-slot"></div>
		<div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
			<div class="overflow-x-auto">
				<table class="min-w-full divide-y divide-slate-200 text-sm">
					<thead class="bg-slate-50 text-left text-xs font-medium uppercase text-slate-500">
						<tr>
							@sortableHeader("Name", "name", "")
							@sortableHeader("Provider", "provider", "")
							@sortableHeader("Kind", "kind", "")
							@sortableHeader("Owner", "owner", "")
							@sortableHeader("Account #", "account_number", "")
							@sortableHeader("Points", "points", "number")
							@sortableHeader("Status", "status", "")
							@sortableHeader("Expires", "expires", "")
							@sortableHeader("Last updated", "last_updated", "")
							<th class="px-4 py-3"></th>
						</tr>
					</thead>
					<tbody id="account-rows" class="divide-y divide-slate-200">
						for _, a := range accts {
							@Row(a)
						}
					</tbody>
				</table>
			</div>
			<div id="empty-state">
				if len(accts) == 0 {
					<p class="px-4 py-6 text-center text-sm text-slate-500">No accounts yet — add one to get started.</p>
				}
			</div>
		</div>
	}
}

// sortableHeader renders a clickable <th> for the accounts table's
// client-side column sort (see web/static/js/sort-table.js). sortType is
// "number" for numeric columns or "" for text/date columns, which sort
// correctly as plain strings (dates are formatted ISO-first in row.templ).
templ sortableHeader(label string, sortKey string, sortType string) {
	<th
		class="cursor-pointer select-none px-4 py-3 hover:text-slate-700"
		data-sort-key={ sortKey }
		if sortType != "" {
			data-sort-type={ sortType }
		}
	>
		{ label }
		<span class="ml-1 inline-block w-3" data-sort-arrow></span>
	</th>
}
