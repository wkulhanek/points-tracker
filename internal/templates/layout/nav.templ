package layout

templ Nav(appName string) {
	<nav class="border-b border-slate-200 bg-white">
		<div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
			<a href="/accounts" class="text-lg font-semibold text-slate-900">{ appName }</a>
			<div class="flex items-center gap-5 text-sm text-slate-600">
				<a href="/accounts" class="hover:text-slate-900">Accounts</a>
				<a href="/settings/email" class="hover:text-slate-900">Email Settings</a>
				<a href="/settings/preferences" class="hover:text-slate-900">Preferences</a>
				<form method="post" action="/logout">
					<button type="submit" class="hover:text-slate-900">Log out</button>
				</form>
			</div>
		</div>
	</nav>
}
