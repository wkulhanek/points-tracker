package components

templ Flash(kind string, message string) {
	if message != "" {
		if kind == "error" {
			<div id="flash" class="mb-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-700 ring-1 ring-red-200">
				{ message }
			</div>
		} else {
			<div id="flash" class="mb-4 rounded-md bg-emerald-50 px-4 py-3 text-sm text-emerald-700 ring-1 ring-emerald-200">
				{ message }
			</div>
		}
	}
}
