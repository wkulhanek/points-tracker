# Copy to .env for local development (not used automatically — see Makefile/README).

# Server
PORT=8080
DATA_DIR=./data
BASE_URL=http://localhost:8080

# Set to false if the app is reachable directly (not behind a trusted reverse
# proxy). When true, the client IP for login rate limiting is read from
# X-Forwarded-For, so the app must never be exposed without a proxy that
# overwrites that header.
TRUST_PROXY=true

# Initial admin account — seeded once, only if the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Google OAuth client (from Google Cloud Console) used for the "Connect Gmail" flow.
# Not required unless you plan to use Gmail as the notification email provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
